# Copy to .env on each web server and fill in. Never commit .env.
GITHUB_OWNER=your-github-username
IMAGE_TAG=latest

# Folder on THIS machine holding courseplanner.db (the rclone pull target).
CATALOGUE_DIR=/srv/coursecompass/data

# From your user-secrets / the collector's environment.
ConnectionStrings__UserData=
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
