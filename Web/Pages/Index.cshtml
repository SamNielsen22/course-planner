@page "/courses"
@model IndexModel
@{
    ViewData["Title"] = "Courses";
    ViewData["Description"] = "Every University of Utah course with its average GPA and grade distribution, searchable by code or title.";
    ViewData["Canonical"] = "/courses";
}

<div class="page-head">
    <h1>Find a Course</h1>
</div>

<form method="get" id="search">
    <div class="search-bar">
        <input name="q" value="@Model.Q" placeholder="CS 2420, calculus, ACCTG&hellip;"
               autocomplete="off" data-autofocus aria-label="Search courses"/>
        <noscript><button type="submit">Search</button></noscript>
    </div>

    <div id="results">
        <partial name="_CourseResults" model="Model"/>
    </div>
</form>

@section Scripts {
<script>
(function () {
    const form = document.getElementById('search');
    const results = document.getElementById('results');
    let timer, latest = 0, page = @Model.Page;

    async function refresh() {
        const params = new URLSearchParams(new FormData(form));
        // Page is tracked here: the pager buttons are also named "page", so a hidden input can't be set.
        params.set('pg', page);
        const mine = ++latest;
        const response = await fetch('?handler=Rows&' + params, {
            headers: { 'X-Requested-With': 'fetch' }
        });
        // Responses can land out of order; only the newest paints.
        if (!response.ok || mine !== latest) return;
        results.innerHTML = await response.text();
        history.replaceState(null, '', '?' + params);
    }

    form.addEventListener('input', function () {
        page = 1;
        clearTimeout(timer);
        timer = setTimeout(refresh, 180);
    });
    // 'change' is for selects and checkboxes. On the text box it fires on blur too, which ate clicks on results; typing is covered by 'input'.
    form.addEventListener('change', function (event) {
        if (event.target.name === 'q') return;
        page = 1; refresh();
    });
    form.addEventListener('submit', function (event) {
        event.preventDefault();
        clearTimeout(timer);
        refresh();
    });
    results.addEventListener('click', function (event) {
        const button = event.target.closest('button[name="pg"]');
        if (!button || button.disabled) return;
        event.preventDefault();
        page = parseInt(button.value, 10);
        refresh();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
})();
</script>
}
