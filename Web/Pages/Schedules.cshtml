@page "/schedules"
@model SchedulesModel
@{
    ViewData["Title"] = "Schedules";
    ViewData["NoIndex"] = true;
    var nextName = $"Schedule {Model.Schedules.Count + 1}";
}

<div class="schedules">
    @* The heading sits on the list's own left edge, like every other page's. *@
    <div class="page-head">
        <h1>Your Schedules</h1>
        @if (!Model.SignedIn && Model.CanSignIn)
        {
            <p class="page-sub">
                Guests keep one schedule, in this browser.
                <a asp-page="/Account/External" asp-page-handler="Start" asp-route-provider="Google"
                   asp-route-returnUrl="/schedules">Sign in with Google</a>
                to keep several and find them on any device.
            </p>
        }
    </div>

@{
    // With nothing to list, the empty card below carries the one action itself.
    var none = Model.SignedIn ? !Model.Unavailable && Model.Schedules.Count == 0 : Model.Guest.Sections.Count == 0;
}
@if (!none)
{
    @* The one action, on the list's own left edge. *@
    <div class="sched-bar">
        @if (Model.SignedIn)
        {
            <button class="btn small-btn" type="button" id="create">New schedule</button>
        }
        else
        {
            <a class="btn small-btn" asp-page="/BuilderAdd">Continue as guest</a>
        }
    </div>
}

@if (none && !Model.SignedIn)
{
    @* A guest with nothing yet: one button, straight into the builder. *@
    <div class="center"><a class="btn" asp-page="/BuilderAdd">Continue as guest</a></div>
}
else if (none)
{
    <div class="sched-none">
        <p class="sched-none-title">No schedules yet</p>
        <p class="sched-none-sub">Create one and start planning a term.</p>
        <button class="btn" type="button" id="create">New schedule</button>
    </div>
}
else if (!Model.SignedIn)
{
    @if (Model.Guest.Sections.Count > 0)
    {
        <ul class="sched-list">
            <li class="sched-row sched-open">
                <a class="sched-hit" asp-page="/BuilderAdd">
                    <span class="sched-dot" aria-hidden="true"></span>
                    <span class="sched-what">
                        <span class="sched-name">Your schedule</span>
                        <span class="sched-meta">
                            @if (Campus.Label(Model.Guest.Campus) is { } guestCampus)
                            {
                                <text>@guestCampus &middot; </text>
                            }
                            @Terms.Display(Model.Guest.Term!) &middot;
                            @Model.Guest.Sections.Count @(Model.Guest.Sections.Count == 1 ? "class" : "classes") &middot;
                            @Model.Guest.Units units
                            @if (Model.Guest.Conflicts > 0)
                            {
                                <text>&middot; </text><span class="sched-warn">@Model.Guest.Conflicts in conflict</span>
                            }
                        </span>
                    </span>
                </a>
            </li>
        </ul>
    }
}
else if (Model.Unavailable)
{
    <p class="sched-empty">Your schedules can't be reached right now. Try again in a moment.</p>
}
else
{
    @* The whole row opens the schedule: it is one submit button wearing the
       dot, the name and the facts. Only the menu at its right is outside it.
       The dot marks the schedule the builder is editing. *@
    <ul class="sched-list">
        @foreach (var s in Model.Schedules)
        {
            <li class="sched-row @(s.IsOpen ? "sched-open" : "")">
                <form method="post" asp-page-handler="Open">
                    <input type="hidden" name="id" value="@s.Id"/>
                    <button class="sched-hit" type="submit">
                        <span class="sched-dot" aria-hidden="true"></span>
                        <span class="sched-what">
                            <span class="sched-name">@s.Name</span>
                            <span class="sched-meta">
                                @if (Campus.Label(s.Campus) is { } campus)
                                {
                                    <text>@campus &middot; </text>
                                }
                                @(s.Term is null ? "No term yet" : Terms.Display(s.Term)) &middot;
                                @s.Classes @(s.Classes == 1 ? "class" : "classes") &middot;
                                @s.Units units
                                @if (s.Conflicts > 0)
                                {
                                    <text>&middot; </text><span class="sched-warn">@s.Conflicts in conflict</span>
                                }
                            </span>
                        </span>
                    </button>
                </form>
                <div class="sched-actions">
                    <details class="row-menu">
                        <summary aria-label="More for @s.Name" title="More">&#8942;</summary>
                        <div class="row-menu-panel">
                            <p class="row-menu-when">Updated @s.UpdatedAt.ToLocalTime().ToString("MMM d")</p>
                            <form method="post" asp-page-handler="Rename" class="row-menu-rename">
                                <input type="hidden" name="id" value="@s.Id"/>
                                <input name="name" value="@s.Name" maxlength="40" aria-label="New name" required/>
                                <button class="btn out small-btn" type="submit">Rename</button>
                            </form>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@s.Id"/>
                                <button class="link-btn danger" type="submit">Delete schedule</button>
                            </form>
                        </div>
                    </details>
                </div>
            </li>
        }
    </ul>
}
</div>

@* Creating a schedule: a name, a term and a campus. The button above opens
   the dialog; with scripting off the form simply shows in place. *@
@if (Model.SignedIn)
{
    <dialog id="create-dialog" class="modal">
        <form method="post" asp-page-handler="New" class="modal-form">
            <h2>New schedule</h2>
            <p class="muted">Pick the term and the campus. A name is optional, and can change later.</p>
            <label>
                Name
                <input name="name" placeholder="@nextName" maxlength="40" autocomplete="off"/>
            </label>
            <label>
                Term
                <select name="term">
                    @foreach (var t in Model.Terms)
                    {
                        <option value="@t">@Terms.Display(t)</option>
                    }
                </select>
            </label>
            @* Main first, so it is what a schedule is for unless said otherwise. *@
            <label>
                Campus
                <select name="campus">
                    @foreach (var (code, name) in Campus.All)
                    {
                        <option value="@code">@name</option>
                    }
                </select>
            </label>
            <div class="modal-actions">
                <button class="btn out" type="button" id="create-cancel">Cancel</button>
                <button class="btn" type="submit">Create</button>
            </div>
        </form>
    </dialog>
    <noscript><style>#create-dialog { display: block; position: static; }</style></noscript>
}

@section Scripts {
<script>
(function () {
    const dialog = document.getElementById('create-dialog');
    const open = document.getElementById('create');
    if (!dialog || !open) return;
    open.addEventListener('click', () => dialog.showModal());
    document.getElementById('create-cancel').addEventListener('click', () => dialog.close());
})();
</script>
}
