@page "/schedules"
@model SchedulesModel
@{
    ViewData["Title"] = "Schedules";
    ViewData["NoIndex"] = true;
    var nextName = $"Schedule {Model.Schedules.Count + 1}";
}

<div class="schedules">
    @* The heading, on the list's left edge. *@
    <div class="page-head">
        <h1>Your Schedules</h1>
        @if (!Model.SignedIn && Model.CanSignIn)
        {
            <p class="page-sub">
                <a asp-page="/Account/External" asp-page-handler="Start" asp-route-provider="Google"
                   asp-route-returnUrl="/schedules">Sign in</a>
                to save your schedule.
            </p>
        }
    </div>

@{
    // Signed in with nothing to list, the empty card below carries the one action itself.
    var none = Model.SignedIn && !Model.Unavailable && Model.Schedules.Count == 0;
}
@if (Model.SignedIn && !none)
{
    @* The one action, on the list's own left edge. *@
    <div class="sched-bar">
        <button class="btn small-btn" type="button" id="create">New schedule</button>
    </div>
}

@if (!Model.SignedIn)
{
    @* A guest has one schedule and is never shown a list: one button into the builder. *@
    <div class="center"><button class="btn" type="button" id="guest">Continue as guest</button></div>
}
else if (none)
{
    <div class="sched-none">
        <p class="sched-none-title">No schedules yet</p>
        <p class="sched-none-sub">Create one and start planning a term.</p>
        <button class="btn" type="button" id="create">New schedule</button>
    </div>
}
else if (Model.Unavailable)
{
    <p class="sched-empty">Your schedules can't be reached right now. Try again in a moment.</p>
}
else
{
    @* The whole row is the button that opens the schedule; the dot marks the open one. *@
    <ul class="sched-list">
        @foreach (var s in Model.Schedules)
        {
            <li class="sched-row @(s.IsOpen ? "sched-open" : "")">
                <form method="post" asp-page-handler="Open">
                    <input type="hidden" name="id" value="@s.Id"/>
                    <button class="sched-hit" type="submit">
                        <span class="sched-dot" aria-hidden="true"></span>
                        <span class="sched-what">
                            <span class="sched-name">@s.Name</span>
                            <span class="sched-meta">
                                @if (Campus.Label(s.Campus) is { } campus)
                                {
                                    <text>@campus &middot; </text>
                                }
                                @(s.Term is null ? "No term yet" : Terms.Display(s.Term)) &middot;
                                @s.Classes @(s.Classes == 1 ? "class" : "classes") &middot;
                                @s.Units units
                                @if (s.Conflicts > 0)
                                {
                                    <text>&middot; </text><span class="sched-warn">@s.Conflicts in conflict</span>
                                }
                            </span>
                        </span>
                    </button>
                </form>
                <div class="sched-actions">
                    <details class="row-menu">
                        <summary aria-label="More for @s.Name" title="More">&#8942;</summary>
                        <div class="row-menu-panel">
                            <p class="row-menu-when">Updated @s.UpdatedAt.ToLocalTime().ToString("MMM d")</p>
                            <form method="post" asp-page-handler="Rename" class="row-menu-rename">
                                <input type="hidden" name="id" value="@s.Id"/>
                                <input name="name" value="@s.Name" maxlength="40" aria-label="New name" required/>
                                <button class="btn out small-btn" type="submit">Rename</button>
                            </form>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@s.Id"/>
                                <button class="link-btn danger" type="submit">Delete schedule</button>
                            </form>
                        </div>
                    </details>
                </div>
            </li>
        }
    </ul>
}
</div>

@* New schedule: a name, a term and a campus. Without scripting the form shows in place. *@
@if (Model.SignedIn)
{
    <dialog id="create-dialog" class="modal">
        <form method="post" asp-page-handler="New" class="modal-form">
            <h2 tabindex="-1" autofocus>New schedule</h2>
            <p class="muted">Pick the term and the campus. A name is optional, and can change later.</p>
            <label>
                Name
                <input name="name" placeholder="@nextName" maxlength="40" autocomplete="off"/>
            </label>
            <label>
                Term
                <select name="term">
                    @foreach (var t in Model.Terms)
                    {
                        <option value="@t">@Terms.Display(t)</option>
                    }
                </select>
            </label>
            @* Main first, so it is the default. *@
            <label>
                Campus
                <select name="campus">
                    @foreach (var (code, name) in Campus.All)
                    {
                        <option value="@code">@name</option>
                    }
                </select>
            </label>
            <div class="modal-actions">
                <button class="btn out" type="button" id="create-cancel">Cancel</button>
                <button class="btn" type="submit">Create</button>
            </div>
        </form>
    </dialog>
    <noscript><style>#create-dialog { display: block; position: static; }</style></noscript>
}

@* A guest's way in: term and campus, then the builder. *@
@if (!Model.SignedIn)
{
    <dialog id="guest-dialog" class="modal">
        <form method="post" asp-page-handler="Guest" class="modal-form">
            <h2 tabindex="-1" autofocus>Continue as guest</h2>
            <label>
                Term
                <select name="term">
                    @foreach (var t in Model.Terms)
                    {
                        <option value="@t" selected="@(t == Model.GuestTerm)">@Terms.Display(t)</option>
                    }
                </select>
            </label>
            <label>
                Campus
                <select name="campus">
                    @foreach (var (code, name) in Campus.All)
                    {
                        <option value="@code" selected="@(code == Model.GuestCampus)">@name</option>
                    }
                </select>
            </label>
            <div class="modal-actions">
                <button class="btn out" type="button" id="guest-cancel">Cancel</button>
                <button class="btn" type="submit">Continue</button>
            </div>
        </form>
    </dialog>
    <noscript><style>#guest-dialog { display: block; position: static; }</style></noscript>
}

@section Scripts {
<script>
(function () {
    for (const [button, dialog, cancel] of [['create', 'create-dialog', 'create-cancel'], ['guest', 'guest-dialog', 'guest-cancel']]) {
        const open = document.getElementById(button), modal = document.getElementById(dialog);
        if (!open || !modal) continue;
        open.addEventListener('click', () => modal.showModal());
        document.getElementById(cancel).addEventListener('click', () => modal.close());
    }
})();
</script>
}
