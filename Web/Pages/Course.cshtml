@page "/course/{subject}/{number}"
@model CourseModel
@inject Web.Pages.PrereqMarkup Prereqs
@{
    ViewData["Title"] = Model.Title is null ? $"{Model.Subject} {Model.Number}" : $"{Model.Subject} {Model.Number}: {Model.Title}";
    ViewData["Description"] = Model.Description;
    ViewData["Canonical"] = Model.Canonical;
}

@* Back to wherever you came from, rather than a fixed page. *@
<div class="page-head page-head-back">
    <button type="button" class="back-arrow" onclick="history.back()" aria-label="Back" title="Back">&larr;</button>
    <div>
        <h1>@Model.Subject @Model.Number</h1>
        @if (Model.Title is not null)
        {
            <p class="subtitle">@Model.Title</p>
        }
    </div>
</div>

<div class="stack">
    <section class="panel">
        <h3>Description</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Info?.Description))
        {
            <p>@Model.Info!.Description</p>
        }
        else
        {
            <p class="muted">No description published.</p>
        }
    </section>

    <section class="panel">
        <h3>Prerequisites</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Info?.Prerequisites))
        {
            <p class="prereq-prose">@Prereqs.Annotate(Model.Info!.Prerequisites)</p>
        }
        else
        {
            <p class="muted">None listed.</p>
        }
    </section>
</div>

@* The term and section filters, only when the course has grades to filter.
   Every term is pooled by default; one term alone is often a single small section. *@
@if (Model.Terms.Count > 0)
{
<form method="get" class="inline-form">
    @if (!Model.ShowSections)
    {
        <input type="hidden" name="from" value="builder"/>
    }
    <select name="term" onchange="location.replace(location.pathname + '?' + new URLSearchParams(new FormData(this.form)))" aria-label="Term">
        <option value="">All terms</option>
        @foreach (var t in Model.Terms)
        {
            <option value="@t" selected="@(t == Model.Term)">@Terms.Display(t)</option>
        }
    </select>
    @* The section picker, listed by professor. Live once a term is picked,
       and hidden for visitors from the builder. *@
    @if (!Model.ShowSections)
    {
    }
    else if (Model.Term is null)
    {
        <select name="section" disabled aria-label="Section">
            <option>Choose a term first</option>
        </select>
    }
    else if (Model.GradedSections.Count == 0)
    {
        <select name="section" disabled aria-label="Section">
            <option>No section grades published</option>
        </select>
    }
    else
    {
        <select name="section" onchange="location.replace(location.pathname + '?' + new URLSearchParams(new FormData(this.form)))" aria-label="Section">
            <option value="">All sections</option>
            @foreach (var s in Model.GradedSections)
            {
                <option value="@s.SectionNumber" selected="@(s.SectionNumber == Model.SectionNumber)">
                    @CourseModel.Professor(s) &middot; Section @s.SectionNumber
                </option>
            }
        </select>
    }
    <noscript><button type="submit">Go</button></noscript>
</form>
}

<partial name="_GradeChart" model="Model.Grades"/>

@if (Model.Grades.Any)
{
    @* Published figures for a term or a section; pooled across terms until the
       registrar's own all-terms row exists. *@
    <partial name="_GradeStats" model="Model.Grades"/>

    @* The average counts every student, the bars only groups of five or more.
       Far apart means the chart is missing grades, so say so. *@
    @if (Model.Grades.HasHiddenGrades)
    {
        <p class="note">
            The bars total fewer students than the average is computed over. The
            University withholds any grade group with fewer than five students,
            so small groups of lower grades are missing from the chart while
            still counting toward the average.
        </p>
    }
}

