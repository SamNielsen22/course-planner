@page "/builder"
@model BuilderAddModel
@{
    ViewData["Title"] = "Schedule Builder";
    ViewData["NoIndex"] = true;
}

@* The term and campus everything on this page is scoped to, stated once,
   with the way back to the schedule home beside the heading. *@
<div class="page-head page-head-back">
    <a class="back-arrow" asp-page="/Schedules" aria-label="Your schedules" title="Your schedules">&larr;</a>
    <div>
        <h1 class="round-start">Schedule Builder</h1>
        <p class="page-sub">Browsing @Terms.Display(Model.Term ?? "")@(Campus.Label(Model.Campus) is { } campus ? " · " + campus : "") sections</p>
    </div>
</div>

@* Filters, results and cart on one screen; the results update as filters change. *@
@Html.AntiForgeryToken()

<form method="get" id="search">
    @* So the live results ask for the term the page shows. *@
    <input type="hidden" name="term" value="@Model.Term"/>
    @* One field: an exact subject code filters by subject, anything else
       matches numbers and titles. *@
    <div class="filters one-line">
        <label class="grow">
            Search
            <input name="q" value="@Model.Q" autocomplete="off" data-autofocus
                   placeholder="Subject, Course Name or Course Code&hellip;"/>
        </label>

        <label>
            Requirement
            <select name="req">
                <option value="">Any</option>
                @foreach (var d in Model.Designations)
                {
                    <option value="@d" selected="@(d == Model.Req)">@d</option>
                }
            </select>
        </label>

        <label>
            Sort by
            <select name="sort">
                <option value="relevance" selected="@(Model.Sort == "relevance")">Relevance</option>
                <option value="name" selected="@(Model.Sort == "name")">Course number</option>
                <option value="gpa" selected="@(Model.Sort == "gpa")">Highest average grade</option>
                <option value="time" selected="@(Model.Sort == "time")">Earliest in the day</option>
                <option value="time_desc" selected="@(Model.Sort == "time_desc")">Latest in the day</option>
            </select>
        </label>

        <label class="check">
            <input type="checkbox" name="open" value="true" checked="@Model.Open"/>
            <input type="hidden" name="open" value="false"/>
            Open seats only
        </label>

        <label class="check">
            <input type="checkbox" name="noClash" value="true" checked="@Model.NoClash"/>
            <input type="hidden" name="noClash" value="false"/>
            No time conflicts
        </label>

        <noscript><button type="submit">Search</button></noscript>
    </div>

    <div class="tabs" role="tablist">
        <button type="button" class="tab tab-on" data-tab="results" role="tab">Results</button>
        <button type="button" class="tab" data-tab="cart" role="tab">
            Your schedule <span class="tab-count">@Model.Cart.Sections.Count</span>
        </button>
    </div>

    <div class="with-cart show-results">
        <div id="results">
            <partial name="_SectionResults" model="Model"/>
        </div>

        <div id="cart-slot">
            <partial name="_Cart" model="Model.Cart"/>
        </div>
    </div>
</form>

@* Back to the top, shown once the page is scrolled down. Not on phones. *@
<button type="button" id="to-top" class="to-top" aria-label="Back to top">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M4 12.5 10 6.5l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
</button>

<dialog id="break-dialog" class="modal">
    <form id="break-form" class="modal-form">
        @* The heading takes the focus, so opening the dialog does not put the
           caret in a field or spring a keyboard. Its outline is removed in the
           stylesheet; tabindex -1 keeps it focusable without joining the tab order. *@
        <h2 tabindex="-1" autofocus>Add a break</h2>
        <label>
            Name
            <input name="name" placeholder="Lunch, work, practice&hellip;"/>
        </label>
        @* One toggle per day, none on to start. The script joins them into "MoWeFr". *@
        <fieldset class="days" id="break-days">
            <legend>Days <span class="days-hint">pick at least one</span></legend>
            @foreach (var (code, letter, name) in new[]
            {
                ("Mo", "M", "Monday"), ("Tu", "T", "Tuesday"), ("We", "W", "Wednesday"), ("Th", "Th", "Thursday"),
                ("Fr", "F", "Friday"), ("Sa", "Sa", "Saturday"), ("Su", "Su", "Sunday"),
            })
            {
                <label class="day-toggle">
                    <input type="checkbox" name="day" value="@code" aria-label="@name"/>
                    <span>@letter</span>
                </label>
            }
        </fieldset>
        <div class="modal-times">
            <label>From<input name="from" type="time" value="12:00" required/></label>
            <label>Until<input name="until" type="time" value="13:00" required/></label>
        </div>
        <div class="modal-actions">
            <button class="btn out" type="button" id="break-cancel">Cancel</button>
            <button class="btn" type="submit">Add break</button>
        </div>
    </form>
</dialog>

@* Chooser for a lecture's required lab, discussion or field-work section. *@
<dialog id="companion-dialog" class="modal">
    <div class="modal-form">
        <h2 id="companion-title">Choose a section</h2>
        <p class="companion-note" id="companion-note" hidden></p>
        <ul class="companion-list" id="companion-list"></ul>
        <div class="modal-actions">
            <button class="btn out" type="button" id="companion-cancel">Cancel</button>
        </div>
    </div>
</dialog>

@section Scripts {
<script>
(function () {
    const form = document.getElementById('search');
    const results = document.getElementById('results');
    let timer, latest = 0, page = @Model.Page;

    async function refresh() {
        const params = new URLSearchParams(new FormData(form));
        // Page is tracked here rather than in a hidden input: the pager buttons
        // are also named "page", so form.elements['page'] returns a list of
        // three and assigning to it does nothing at all.
        params.set('pg', page);
        const mine = ++latest;
        const response = await fetch('?handler=Rows&' + params, {
            headers: { 'X-Requested-With': 'fetch' }
        });
        // Responses can land out of order; only the newest may paint.
        if (!response.ok || mine !== latest) return;
        results.innerHTML = await response.text();
        history.replaceState(null, '', '?' + params);
    }

    const cartSlot = document.getElementById('cart-slot');
    async function refreshCart() {
        const response = await fetch('?handler=Cart', {
            headers: { 'X-Requested-With': 'fetch' }
        });
        if (!response.ok) return;
        cartSlot.innerHTML = await response.text();

        // The tab badge lives outside the swapped panel, so it has to be told.
        // Without this it kept whatever count the page was first rendered with,
        // which on a fresh visit is always zero. Counted from the rows, since
        // the cart itself no longer shows a number.
        const badge = document.querySelector('.tab-count');
        if (badge) badge.textContent = cartSlot.querySelectorAll('.cart-drop').length;
    }

    // Delegated, so these survive the panel being replaced.
    const dialog = document.getElementById('break-dialog');
    const breakForm = document.getElementById('break-form');

    cartSlot.addEventListener('click', async function (event) {
        const remove = event.target.closest('.cart-drop');
        if (remove) { event.preventDefault(); drop(remove, remove.dataset.key); return; }

        const dropBreak = event.target.closest('.cart-dropbreak');
        if (dropBreak) {
            event.preventDefault();
            dropBreak.disabled = true;
            const response = await post('DropBreak', { id: dropBreak.dataset.id });
            if (response.ok) { refresh(); refreshCart(); } else dropBreak.disabled = false;
            return;
        }

        if (event.target.closest('.cart-addbreak')) dialog.showModal();
    });

    document.getElementById('break-cancel').addEventListener('click', () => dialog.close());
    document.getElementById('break-days').addEventListener('change', function () { this.classList.remove('days-missing'); });
    breakForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        const fields = new FormData(breakForm);
        const days = document.getElementById('break-days');
        if (fields.getAll('day').length === 0) { days.classList.add('days-missing'); return; }
        const data = Object.fromEntries(fields);
        delete data.day;
        data.days = fields.getAll('day').join('');   // "MoWeFr", in week order as the boxes are
        const response = await post('AddBreak', data);
        if (response.ok) { dialog.close(); breakForm.reset(); refresh(); refreshCart(); }
    });

    // Tabs, on narrow screens only. The classes are inert at desktop width.
    const columns = document.querySelector('.with-cart');
    document.querySelector('.tabs').addEventListener('click', function (event) {
        const tab = event.target.closest('.tab');
        if (!tab) return;
        document.querySelectorAll('.tab').forEach(t => t.classList.toggle('tab-on', t === tab));
        const onCart = tab.dataset.tab === 'cart';
        columns.classList.toggle('show-results', !onCart);
        columns.classList.toggle('show-cart', onCart);
        form.classList.toggle('on-cart', onCart);
    });

    // Any change to the search itself starts again from the first page.
    form.addEventListener('input', function () {
        page = 1;
        clearTimeout(timer);
        timer = setTimeout(refresh, 180);
    });
    // 'change' is for the selects and checkboxes. On the text box it also fires
    // on blur - i.e. the mousedown of a click on a result - which re-rendered the
    // results between mousedown and mouseup and ate the click. Typing is
    // already covered by 'input'.
    form.addEventListener('change', function (event) {
        if (event.target.name === 'q') return;
        page = 1; refresh();
    });
    form.addEventListener('submit', function (event) {
        event.preventDefault();
        clearTimeout(timer);
        refresh();
    });
    function token() {
        const field = document.querySelector('input[name="__RequestVerificationToken"]');
        return field ? field.value : '';
    }

    async function post(handler, body) {
        return fetch('?handler=' + handler, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token()
            },
            body: new URLSearchParams(body)
        });
    }

    // Removing changes the results as well as the cart: the control flips back
    // to a plus, and with the clash filter on, freeing a slot can let other
    // sections reappear.
    async function drop(button, key) {
        button.disabled = true;
        const response = await post('Drop', { key });
        if (response.ok) { refresh(); refreshCart(); } else button.disabled = false;
    }

    // Adding a section posts on its own; the surrounding form is a GET search
    // and must not be submitted by it.
    results.addEventListener('click', async function (event) {
        const remove = event.target.closest('button.drop-section');
        if (remove) { event.preventDefault(); drop(remove, remove.dataset.key); return; }

        // A lecture with a required section opens the chooser instead of adding.
        const pair = event.target.closest('button.add-pair');
        if (pair) { event.preventDefault(); openCompanionChooser(pair); return; }

        const add = event.target.closest('button.add-section');
        if (add) {
            event.preventDefault();
            add.disabled = true;
            const response = await post('Add', {
                term: add.dataset.term, subject: add.dataset.subject,
                number: add.dataset.number, section: add.dataset.section
            });
            if (response.ok) { refresh(); refreshCart(); } else add.disabled = false;
            return;
        }

        const button = event.target.closest('button[name="pg"]');
        if (!button || button.disabled) return;
        event.preventDefault();
        page = parseInt(button.value, 10);
        refresh();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ------------------------------------------------------------ companion chooser
    const companionDialog = document.getElementById('companion-dialog');
    const companionList = document.getElementById('companion-list');
    const companionTitle = document.getElementById('companion-title');
    const companionNote = document.getElementById('companion-note');
    let pairContext = null;   // {term, subject, number, lecture}

    function seatLabel(seats) {
        if (seats === null || seats === undefined) return '';
        if (seats > 0) return seats + ' seat' + (seats === 1 ? '' : 's') + ' open';
        return 'Full';
    }

    // The choices are embedded with the results, so the chooser opens instantly.
    function companionChoices(lectureKey) {
        const island = document.getElementById('companion-data');
        if (!island) return null;
        try { return (JSON.parse(island.textContent || '{}'))[lectureKey] || null; }
        catch { return null; }
    }

    function openCompanionChooser(button) {
        pairContext = {
            term: button.dataset.term, subject: button.dataset.subject,
            number: button.dataset.number, lecture: button.dataset.section
        };
        const kind = button.dataset.kind || 'section';
        companionTitle.textContent = 'Choose a ' + kind;
        companionList.innerHTML = '';
        companionNote.hidden = true;
        if (typeof companionDialog.showModal === 'function') companionDialog.showModal();

        const key = pairContext.term + '|' + pairContext.subject + '|' + pairContext.number + '|' + pairContext.lecture;
        const choices = companionChoices(key);
        if (!choices) { companionList.innerHTML = '<li class="companion-loading">Could not load sections.</li>'; return; }

        if (!choices.length) { companionList.innerHTML = '<li class="companion-loading">No sections to choose from.</li>'; return; }
        if (choices.some(c => !c.published)) {
            companionNote.textContent = 'The registrar has not published which ' + kind
                + ' goes with this lecture, so every one is listed. Check with the department if unsure.';
            companionNote.hidden = false;
        }

        companionList.innerHTML = '';
        for (const c of choices) {
            const li = document.createElement('li');
            const full = (c.seats !== null && c.seats <= 0);
            li.innerHTML =
                '<button type="button" class="companion-pick" data-section="' + c.section + '"' + (full ? ' data-full="1"' : '') + '>'
                + '<span class="companion-sec">Section ' + c.section + '</span>'
                + '<span class="companion-when">' + (c.times ? c.times : 'No meeting time')
                + (c.location ? ' &middot; ' + c.location : '') + '</span>'
                + (c.professor ? '<span class="companion-who">' + c.professor + '</span>' : '')
                + '<span class="companion-seats ' + (full ? 'full' : 'open') + '">' + seatLabel(c.seats) + '</span>'
                + '</button>';
            companionList.appendChild(li);
        }
    }

    companionList.addEventListener('click', async function (event) {
        const pick = event.target.closest('button.companion-pick');
        if (!pick || !pairContext) return;
        pick.disabled = true;
        const response = await post('AddPair', {
            term: pairContext.term, subject: pairContext.subject,
            number: pairContext.number, lecture: pairContext.lecture, companion: pick.dataset.section
        });
        if (response.ok) { companionDialog.close(); refresh(); refreshCart(); }
        else pick.disabled = false;
    });
    document.getElementById('companion-cancel').addEventListener('click', () => companionDialog.close());
    companionDialog.addEventListener('click', e => { if (e.target === companionDialog) companionDialog.close(); });

    // Back to top: shown once the reader is a screen or so down the list.
    const toTop = document.getElementById('to-top');
    const stillness = matchMedia('(prefers-reduced-motion: reduce)');
    function placeToTop() { toTop.classList.toggle('on', window.scrollY > 600); }
    addEventListener('scroll', placeToTop, { passive: true });
    placeToTop();
    toTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: stillness.matches ? 'auto' : 'smooth' });
    });
})();
</script>
}
