@page "/professor/{unid}/{slug?}/{course?}"
@model InstructorModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["Description"] = Model.Description;
    ViewData["Canonical"] = Model.Canonical;
}

<div class="page-head page-head-back">
    <button type="button" class="back-arrow" onclick="history.back()" aria-label="Back" title="Back">&larr;</button>
    <div>
        <h1>@Model.Display</h1>
        @if (Model.Course is not null)
        {
            <p class="page-sub">@Model.Course@(Model.ClassTitle is null ? "" : ":")@if (Model.ClassTitle is not null){<span class="ps-title">@Model.ClassTitle</span>}</p>
        }
    </div>
</div>

@if (Model.Terms.Count == 0)
{
    <p class="note">No published grades for this professor.</p>
}
else
{
    <form method="get" class="inline-form" action="@Model.Base">
        <select name="term" aria-label="Term">
            @foreach (var t in Model.Terms)
            {
                <option value="@t" selected="@(t == Model.Term)">@Terms.Display(t)</option>
            }
        </select>
        <select name="course" aria-label="Class">
            @foreach (var code in Model.Classes)
            {
                <option value="@code" selected="@(code == Model.Course)">@code</option>
            }
        </select>
        @if (Model.Sections.Count > 1)
        {
            <select name="section" aria-label="Section">
                @foreach (var s in Model.Sections)
                {
                    <option value="@s.Key" selected="@(s.Key == Model.SectionKey)">@s.Label</option>
                }
            </select>
        }
        <noscript><button type="submit">Go</button></noscript>
    </form>

    @foreach (var block in Model.Blocks)
    {
        <div class="prof-section" data-key="@block.Key" hidden="@(block.Key != Model.SectionKey)">
            <partial name="_GradeChart" model="block.Grades"/>
            @if (block.Grades.Any)
            {
                <partial name="_GradeStats" model="block.Grades"/>

                @* The average counts every student, the bars only groups of five or more. If they're far apart, say so. *@
                @if (block.Grades.HasHiddenGrades)
                {
                    <p class="note">
                        The bars total fewer students than the average is computed over. The
                        University withholds any grade group with fewer than five students,
                        so small groups of lower grades are missing from the chart while
                        still counting toward the average.
                    </p>
                }
            }
        </div>
    }

    <script type="application/json" id="prof-data">@Html.Raw(Model.DataJson)</script>
}

<div class="center stack-tight">
    <a class="link" href="@Model.RateMyProfessorUrl" target="_blank" rel="noopener noreferrer">
        Search on Rate My Professor
    </a>
</div>

@section Scripts {
@* The pickers work on what's already in the page: term narrows classes, class narrows sections. A fragment can name a class; it opens in the newest term that has it, summer last like the server. *@
<script>
(function () {
    const source = document.getElementById('prof-data');
    const form = document.querySelector('form.inline-form');
    if (!source || !form) return;
    const data = JSON.parse(source.textContent);
    const termPick = form.querySelector('[name=term]');
    const coursePick = form.querySelector('[name=course]');
    let sectionPick = form.querySelector('[name=section]');
    const sub = document.querySelector('.page-sub');

    function fill(select, items, chosen) {
        select.innerHTML = '';
        for (const item of items) {
            const option = document.createElement('option');
            option.value = item.value; option.textContent = item.text; option.selected = item.value === chosen;
            select.appendChild(option);
        }
    }
    function show(key) {
        document.querySelectorAll('.prof-section').forEach(block => { block.hidden = block.dataset.key !== key; });
    }
    function pick(term, course, key) {
        const classes = Object.keys(data.tree[term]);
        if (!classes.includes(course)) course = classes[0];
        fill(coursePick, classes.map(c => ({ value: c, text: c })), course);
        const sections = data.tree[term][course];
        if (!sections.some(s => s.key === key)) key = sections[0].key;
        if (sections.length > 1) {
            if (!sectionPick) {
                sectionPick = document.createElement('select');
                sectionPick.name = 'section'; sectionPick.setAttribute('aria-label', 'Section');
                coursePick.after(sectionPick);
                sectionPick.addEventListener('change', () => show(sectionPick.value));
            }
            fill(sectionPick, sections.map(s => ({ value: s.key, text: s.label })), key);
        } else if (sectionPick) {
            sectionPick.remove(); sectionPick = null;
        }
        show(key);
        if (sub) {
            sub.textContent = course;
            const title = data.titles[course];
            if (title) {
                sub.append(':');
                const span = document.createElement('span'); span.className = 'ps-title'; span.textContent = title;
                sub.append(span);
            }
        }
    }

    termPick.addEventListener('change', () => pick(termPick.value, coursePick.value, null));
    coursePick.addEventListener('change', () => pick(termPick.value, coursePick.value, null));
    if (sectionPick) sectionPick.addEventListener('change', () => show(sectionPick.value));

    const named = data.slugs[location.hash.slice(1)];
    if (named) {
        const has = t => data.tree[t] && data.tree[t][named];
        const term = (data.preferNonSummer && data.terms.find(t => has(t) && !t.startsWith('Summer')))
                     || data.terms.find(has);
        if (term) { termPick.value = term; pick(term, named, null); }
    }
})();
</script>
}
