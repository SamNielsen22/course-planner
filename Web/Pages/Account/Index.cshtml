@page "/account"
@model Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Your Account";
    ViewData["NoIndex"] = true;
    var problem = ViewData.ModelState.ErrorCount > 0;
}

<div class="page-head center">
    <h1>Your Account</h1>
    <p class="page-sub">
        @Model.Email
        @if (Model.Provider is not null)
        {
            <text>&middot; signed in with @Model.Provider</text>
        }
    </p>
</div>

<div class="account-page stack">
    <form method="post" asp-page-handler="Logout" class="account-row">
        <button type="submit" class="btn out">Sign out</button>
    </form>

    @* Out of the way until wanted; opens itself if the confirmation was missed. *@
    <details class="account-danger" open="@problem">
        <summary>Delete account</summary>
        <p class="muted">Removes your account and your saved schedule. There is no undo.</p>
        <form method="post" asp-page-handler="Delete">
            <label class="check"><input type="checkbox" name="confirm" value="true"/> I understand</label>
            <div asp-validation-summary="All" class="errors"></div>
            <button type="submit" class="btn out danger">Delete my account</button>
        </form>
    </details>
</div>
