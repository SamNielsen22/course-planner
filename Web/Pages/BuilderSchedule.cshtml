@page
@model BuilderScheduleModel
@{
    ViewData["Title"] = "Your Schedule";
    ViewData["NoIndex"] = true;
}

@* The same arrow the builder wears, back to it. *@
<div class="page-head page-head-back">
    <a class="back-arrow" asp-page="/BuilderAdd" aria-label="Schedule builder" title="Schedule builder">&larr;</a>
    <div>
        <h1>@(Model.Schedule.Name ?? "Your Schedule")</h1>
        @if (Model.Schedule.Sections.Count > 0)
        {
            <p class="page-sub">@Terms.Display(Model.Schedule.Sections[0].Term)@(Campus.Label(Model.Schedule.Campus) is { } campus ? " · " + campus : "")</p>
        }
    </div>
</div>

@if (Model.Schedule.Sections.Count == 0)
{
    <p class="empty">
        Nothing in your schedule yet.
        <a asp-page="/BuilderAdd">Add a course</a> to see it laid out here.
    </p>
}
else
{
    @if (!Model.Online)
    {
    @* Clashes are reported, not prevented. *@
    @if (Model.Clashes.Count > 0)
    {
        <div class="notice warn">
            <strong>@Model.Clashes.Count time conflict@(Model.Clashes.Count == 1 ? "" : "s").</strong>
            @* Named by section when a course appears twice. *@
            @{
                var repeated = Model.Blocks.Where(x => !x.IsBreak).GroupBy(x => x.Label)
                    .Where(g => g.Select(x => x.Detail).Distinct().Count() > 1).Select(g => g.Key).ToHashSet();
                string Who(Placed x) => repeated.Contains(x.Label) ? $"{x.Label} {x.Detail.ToLowerInvariant()}" : x.Label;
            }
            <ul class="clash-list">
                @foreach (var (a, b) in Model.Clashes)
                {
                    <li>
                        @Who(a) and @Who(b) overlap on @BuilderScheduleModel.DayName(a.Day),
                        @BuilderScheduleModel.Clock(Math.Max(a.Start, b.Start))&ndash;@BuilderScheduleModel.Clock(Math.Min(a.End, b.End))
                    </li>
                }
            </ul>
        </div>
    }

    @* Narrow screens get "Wed", or the full day names push the grid off the edge. *@
    <div class="week" style="grid-template-columns: 3.5rem repeat(@Model.Days.Count, minmax(0, 1fr))">
        <div class="head"></div>
        @foreach (var day in Model.Days)
        {
            <div class="head">
                <span class="day-long">@BuilderScheduleModel.DayName(day)</span>
                <span class="day-short">@BuilderScheduleModel.DayName(day)[..3]</span>
            </div>
        }

        <div class="times">
            @foreach (var hour in Model.Hours)
            {
                <div class="hour">@BuilderScheduleModel.Clock(hour * 60)</div>
            }
        </div>

        @foreach (var day in Model.Days)
        {
            <div class="col">
                @foreach (var hour in Model.Hours)
                {
                    <div class="cell"></div>
                }
                @foreach (var block in Model.Blocks.Where(b => b.Day == day))
                {
                    var (top, height) = Model.Position(block);
                    <div class="block @(block.IsBreak ? "block-break" : "") @(Model.InConflict.Contains(block) ? "block-clash" : "")"
                         style="top: @top.ToString("0.##")%; height: @height.ToString("0.##")%"
                         title="@block.Label &middot; @BuilderScheduleModel.Clock(block.Start)-@BuilderScheduleModel.Clock(block.End)">
                        <span class="block-label">@block.Label</span>
                        <span class="block-time">@BuilderScheduleModel.Clock(block.Start)</span>
                    </div>
                }
            </div>
        }
    </div>
    }

    <table>
        <thead>
        <tr>
            <th>Course</th>
            <th>Section</th>
            <th>Professor</th>
            @if (!Model.Online)
            {
                <th>Days &amp; time</th>
                <th>Location</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Schedule.Sections)
        {
            <tr>
                <td class="code">
                    <a asp-page="/Course" asp-route-subject="@s.Subject" asp-route-number="@s.CourseNumber">@s.Code</a>
                </td>
                <td class="code">@s.SectionNumber</td>
                <td>@(s.Professor ?? "—")</td>
                @if (!Model.Online)
                {
                    <td class="muted">@(s.Times ?? "—")</td>
                    <td class="muted">@(s.Location ?? "—")</td>
                }
            </tr>
        }
        </tbody>
    </table>

    @* Weekly events for the term, days off skipped. Only for terms the academic
       calendar knows. On iOS Safari the script relabels it "Save to calendar". *@
    @if (Model.Online)
    {
    }
    else if (Model.Calendar is not null && Model.Blocks.Any(b => !b.IsBreak))
    {
        <div class="center stack-tight">
            <a class="btn" id="ics-button" asp-page-handler="Ics">Export to calendar</a>
            <p class="muted ics-note" id="ics-note">
                Downloads an .ics file. Open it to add your classes to Google Calendar or Apple Calendar.
            </p>
        </div>
    }
    else if (Model.Calendar is null)
    {
        <p class="note">
            Calendar export needs the term's class dates, which are not on file
            for @Terms.Display(Model.Schedule.Sections[0].Term).
        </p>
    }

}

@section Scripts {
<script>
(function () {
    // Safari on an iPhone or iPad opens the file itself, with an "Add All"
    // button: nothing is exported or explained, it is simply saved.
    const button = document.getElementById('ics-button');
    const note = document.getElementById('ics-note');
    const ua = navigator.userAgent;
    if (button && /iPhone|iPad|iPod/.test(ua) && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua)) {
        button.textContent = 'Save to calendar';
        if (note) note.remove();
    }
})();
</script>
}
