@model CoursePlanner.Data.GradeDistribution
@{
    // Empty buckets are dropped, so CR/NC don't take half the width of courses that never used them.
    var bars = Model.Bars.Where(b => b.Count > 0).ToList();
    var peak = bars.Count == 0 ? 0 : bars.Max(b => b.Count);
    var step = peak switch
    {
        <= 10 => 2,
        <= 40 => 10,
        <= 100 => 25,
        <= 400 => 100,
        <= 1000 => 250,
        _ => 500
    };
    var ceiling = Math.Max(step, (int)(Math.Ceiling(peak / (double)step) * step));
    var ticks = Enumerable.Range(0, ceiling / step + 1).Select(i => i * step).Reverse().ToList();
}

@if (bars.Count == 0)
{
    <p class="empty">No grades published for this selection.</p>
}
else
{
    <div class="chart">
        <div class="chart-plot">
            @* Lines sit above their tick to clear the axis band; the top edge needs none. *@
            @foreach (var tick in ticks.Where(t => t < ceiling))
            {
                <div class="chart-grid" style="bottom: @(tick * 100.0 / ceiling)%"></div>
            }
            <div class="chart-bars">
                @foreach (var (label, count) in bars)
                {
                    <div class="chart-bar" title="@label: @count">
                        @* Height is a custom property the animation grows into, so a redraw reads as the same bars moving. *@
                        <div class="chart-fill" style="--h: @(count * 100.0 / ceiling)%">
                            <span class="chart-value">@count</span>
                        </div>
                        <span class="chart-label">@label</span>
                    </div>
                }
            </div>
        </div>
    </div>
}
