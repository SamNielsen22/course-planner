@model Web.Pages.BuilderAddModel
@inject Web.Pages.PrereqMarkup Prereqs

@* The companion choices for this page's required lectures, so the chooser opens
   with no round trip. Rebuilt with the results on every search. *@
<script id="companion-data" type="application/json">@Html.Raw(Model.CompanionData)</script>

@if (Model.Total == 0)
{
    <p class="empty">No sections matched.</p>
}
else
{
    @* A head only when there is more than one page. *@
    @if (Model.LastPage > 1)
    {
    <div class="results-head">
        @* An unseen copy of the widest form holds the width, so the chevrons never move. *@
        <p class="count">
            <span>Page @Model.Page of @Model.LastPage</span>
            <span class="count-widest" aria-hidden="true">Page @Model.LastPage of @Model.LastPage</span>
        </p>
        @* The same steps as at the foot, compact enough for one line on a phone. *@
            <nav class="pager-top" aria-label="Pages">
                <button type="submit" name="pg" value="@(Model.Page - 1)" class="step"
                        disabled="@(!Model.HasPrevious)" aria-label="Previous page">
                    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="submit" name="pg" value="@(Model.Page + 1)" class="step"
                        disabled="@(!Model.HasNext)" aria-label="Next page">
                    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </nav>
    </div>
    }

    <div class="section-cards">
        @foreach (var s in Model.Results)
        {
            <article class="section-card">
                @* Add or remove, in the card's corner. *@
                @{ var key = $"{Model.Term}|{s.Subject}|{s.CourseNumber}|{s.SectionNumber}"; }
                @if (Model.Picked.Contains(key))
                {
                    <button class="sc-corner drop-section" type="button"
                            title="Remove this section from your schedule"
                            aria-label="Remove @s.Subject @s.CourseNumber section @s.SectionNumber"
                            data-key="@key">&minus;</button>
                }
                else if (s.RequiresCompanion)
                {
                    @* Adding a lecture opens a chooser for its required section. *@
                    <button class="sc-corner add-section add-pair" type="button"
                            title="Add this class and choose its @s.CompanionKind"
                            aria-label="Add @s.Subject @s.CourseNumber section @s.SectionNumber and choose its @s.CompanionKind"
                            data-term="@Model.Term" data-subject="@s.Subject"
                            data-number="@s.CourseNumber" data-section="@s.SectionNumber"
                            data-kind="@s.CompanionKind">+</button>
                }
                else
                {
                    <button class="sc-corner add-section" type="button"
                            title="Add this section to your schedule"
                            aria-label="Add @s.Subject @s.CourseNumber section @s.SectionNumber"
                            data-term="@Model.Term" data-subject="@s.Subject"
                            data-number="@s.CourseNumber" data-section="@s.SectionNumber">+</button>
                }

                @if (s.Units is { } units)
                {
                    <span class="sc-units">@units unit@(units == 1 ? "" : "s")</span>
                }

                <div class="sc-row sc-head">
                    @* from=builder hides the course page's section picker. *@
                    <a class="sc-code link" asp-page="/Course" asp-route-from="builder"
                       asp-route-subject="@s.Subject" asp-route-number="@s.CourseNumber">@s.Subject @s.CourseNumber</a>
                    <span class="sc-section">Section @s.SectionNumber</span>
                    <span class="sc-title">@s.Title</span>
                </div>

                @* Who teaches it, with their figures directly underneath. *@
                <div class="sc-row">
                    <div class="sc-prof">
                        @if (s.Instructors.Count == 0)
                        {
                            <span class="muted">No professor listed</span>
                        }
                        else
                        {
                            @* Everyone teaching it, as prose. Past three, the rest fold behind "and N more". *@
                            var total = s.Instructors.Count;
                            var shown = s.Instructors.Take(3).ToList();
                            var rest = s.Instructors.Skip(3).ToList();
                            string Before(int i) => total > 1 && i == total - 1 ? "and " : "";
                            string After(int i) => i < total - 2 ? "," : "";
                            for (var n = 0; n < shown.Count; n++)
                            {
                                // The third name's comma belongs only once the fold is open.
                                var folded = n == shown.Count - 1 && rest.Count > 0 && After(n) == ",";
                                <span class="sc-one @(folded ? "sc-comma-open" : "")">@Before(n)<a class="link" asp-page="/Instructor" asp-route-unid="@shown[n].Unid" asp-route-slug="@Web.Pages.Names.Slug(shown[n].Name)"
                                   asp-route-course="@Web.Pages.Names.CourseSlug(s.Subject, s.CourseNumber)" asp-route-planning="@Model.Term">@Web.Pages.Names.Natural(shown[n].Name)</a>@(folded ? "" : After(n))</span>
                            }
                            if (rest.Count > 0)
                            {
                                <details class="sc-more">
                                    <summary>and @rest.Count more</summary>
                                    @for (var k = 0; k < rest.Count; k++)
                                    {
                                        var i = shown.Count + k;
                                        <span class="sc-one">@Before(i)<a class="link" asp-page="/Instructor" asp-route-unid="@rest[k].Unid" asp-route-slug="@Web.Pages.Names.Slug(rest[k].Name)"
                                           asp-route-course="@Web.Pages.Names.CourseSlug(s.Subject, s.CourseNumber)" asp-route-planning="@Model.Term">@Web.Pages.Names.Natural(rest[k].Name)</a>@After(i)</span>
                                    }
                                </details>
                            }
                        }
                    </div>

                    @* The course average, then each professor's, up to three. *@
                    <div class="sc-grades">
                        <div class="sc-fig">
                            <span class="sc-label">Course average</span>
                            <span class="sc-value">@Figures.Gpa(s.CourseAvgGpa)</span>
                        </div>
                        @if (s.Instructors.Count == 1)
                        {
                            <div class="sc-fig">
                                <span class="sc-label">This professor</span>
                                <span class="sc-value">@Figures.Gpa(s.InstructorAverages.GetValueOrDefault(s.Instructors[0].Unid))</span>
                            </div>
                        }
                        else if (s.Instructors.Count <= 3)
                        {
                            foreach (var i in s.Instructors)
                            {
                                <div class="sc-fig">
                                    <span class="sc-label">@Web.Pages.Names.Family(i.Name)</span>
                                    <span class="sc-value">@Figures.Gpa(s.InstructorAverages.GetValueOrDefault(i.Unid))</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="sc-row sc-meet">
                    @* A lecture whose course has a required lab, discussion or field-work
                       section. The section itself is chosen in the popup when the class is added. *@
                    @if (s.RequiresCompanion)
                    {
                        <p class="sc-pair"><span class="sc-req">@(char.ToUpper(s.CompanionKind![0]) + s.CompanionKind[1..]) required</span></p>
                    }
                    @* UOnline sections never meet at an hour or in a room. *@
                    @if (s.Campus != "online")
                    {
                        <p class="sc-when">
                            @Web.Schedule.Meetings.Display(s.Times)
                            @if (!string.IsNullOrWhiteSpace(s.Location))
                            {
                                <text>&middot; @s.Location</text>
                            }
                        </p>
                    }
                    <p class="sc-facts">
                        @if (s.SeatsAvailable is { } seats)
                        {
                            <span class="@(seats > 0 ? "open" : "full")">
                                @if (seats > 0)
                                {
                                    @($"{seats} seat{(seats == 1 ? "" : "s")} open")
                                }
                                else
                                {
                                    @* Full: how many are waiting, and whether a wait list exists. *@
                                    <text>Full</text>
                                    @if (s.Waitlist is { } waiting && (waiting > 0 || s.HasWaitlist != false))
                                    {
                                        <text>: waitlist @waiting</text>
                                    }
                                    else if (s.HasWaitlist == false)
                                    {
                                        <text>: no waitlist</text>
                                    }
                                }
                            </span>
                        }
                    </p>
                </div>

                @* The registrar's own prerequisite text, verbatim. *@
                <div class="sc-row sc-prereq">
                    <span class="sc-label">Prerequisites</span>
                    @if (string.IsNullOrWhiteSpace(s.Prerequisites))
                    {
                        <p class="muted">None listed</p>
                    }
                    else
                    {
                        <p>@Prereqs.Annotate(s.Prerequisites)</p>
                    }
                </div>

            </article>
        }
    </div>

    @if (Model.LastPage > 1)
    {
        @* The foot of the list: the same chevrons as the head, either side of the page. *@
        <nav class="pager" aria-label="Pages">
            <button type="submit" name="pg" value="@(Model.Page - 1)" class="step"
                    disabled="@(!Model.HasPrevious)" aria-label="Previous page">
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <span class="pager-at">@Model.Page / @Model.LastPage</span>
            <button type="submit" name="pg" value="@(Model.Page + 1)" class="step"
                    disabled="@(!Model.HasNext)" aria-label="Next page">
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </nav>
    }
}
