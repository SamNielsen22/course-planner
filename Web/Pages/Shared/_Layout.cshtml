@inject Web.Unlisted Unlisted
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#ffffff"/>
    <title>@(ViewData["NoIndex"] is null && ViewData["Title"] is string title ? title : "Utah Course Compass")</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description"/>
        <meta property="og:description" content="@description"/>
    }
    <meta property="og:title" content="@ViewData["Title"]"/>
    <meta property="og:site_name" content="Utah Course Compass"/>
    @if (ViewData["Canonical"] is string canonical)
    {
        <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{canonical}")"/>
    }
    @* Unlisted, a page may still opt in with Listed: the front page and About do. *@
    @if (ViewData["NoIndex"] is true || (Unlisted.Yes && ViewData["Listed"] is not true))
    {
        <meta name="robots" content="noindex"/>
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" asp-append-version="true"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" asp-append-version="true"/>
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" asp-append-version="true"/>
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" asp-append-version="true"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&display=swap"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav>
        <a class="brand" asp-page="/Home">
            <img class="brand-mark" src="/logo.svg" asp-append-version="true" alt="" width="34" height="25"/>
            Utah Course Compass
        </a>
        <span class="links">
            <a asp-page="/BuilderAdd">Schedule Builder</a>
            <a asp-page="/Index">Courses</a>
            <a asp-page="/Instructors">Professors</a>
        </span>
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <p>Utah Course Compass &middot; Not affiliated with the University of Utah.</p>
</footer>

@* Search box takes focus on desktop only; on a phone it would raise the keyboard. *@
<script>
(function () {
    const desktop = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 721px)');
    function focusSearch() {
        const box = document.querySelector('input[data-autofocus]');
        // A page can decline the focus once: the builder does, opened from a course.
        if (!box || box.dataset.autofocus === 'off' || !desktop.matches) return;
        box.focus({ preventScroll: true });
        if (!box.value) return;
        const end = box.value.length;
        try { box.setSelectionRange(end, end); } catch (e) { }
    }
    focusSearch();
    window.addEventListener('pageshow', focusSearch);
})();
</script>
@* On touch, a course code shows its title on the first tap and follows the link on the second. Delegated so swapped-in cards get it too. *@
<script>
(function () {
    function keepOnScreen(ref) {
        ref.style.removeProperty('--tip-shift');
        const width = parseFloat(getComputedStyle(ref, '::after').width) || 0;
        const at = ref.getBoundingClientRect(), centre = (at.left + at.right) / 2, edge = 8;
        let shift = 0;
        if (centre - width / 2 < edge) shift = edge - (centre - width / 2);
        else if (centre + width / 2 > innerWidth - edge) shift = (innerWidth - edge) - (centre + width / 2);
        if (shift) ref.style.setProperty('--tip-shift', shift + 'px');
    }
    document.addEventListener('mouseover', function (event) {
        const ref = event.target.closest('a.course-ref');
        if (ref) keepOnScreen(ref);
    });
    if (!matchMedia('(hover: none)').matches) return;
    document.addEventListener('click', function (event) {
        const ref = event.target.closest('a.course-ref');
        document.querySelectorAll('a.course-ref.open').forEach(o => { if (o !== ref) o.classList.remove('open'); });
        if (ref && !ref.classList.contains('open')) { event.preventDefault(); ref.classList.add('open'); keepOnScreen(ref); }
    });
})();
</script>
@* land=grades opens the page on the chart with its foot at the foot of the screen. A query, not a fragment, because a fragment makes the browser scroll on its own. Run once now and once after load in case a late font moved things. *@
<script>
(function () {
    if (!matchMedia('(max-width: 900px)').matches) return;
    const part = document.getElementById(new URLSearchParams(location.search).get('land') || '');
    if (!part) return;
    const land = () => part.scrollIntoView({ block: part.dataset.land || 'center' });
    land();
    window.addEventListener('load', land, { once: true });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
