@inject Web.Unlisted Unlisted
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#ffffff"/>
    <title>@(ViewData["NoIndex"] is null && ViewData["Title"] is string title ? title : "Utah Course Compass")</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description"/>
        <meta property="og:description" content="@description"/>
    }
    <meta property="og:title" content="@ViewData["Title"]"/>
    <meta property="og:site_name" content="Utah Course Compass"/>
    @if (ViewData["Canonical"] is string canonical)
    {
        <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{canonical}")"/>
    }
    @* Unlisted, a page may still opt in with Listed: the front page and About do. *@
    @if (ViewData["NoIndex"] is true || (Unlisted.Yes && ViewData["Listed"] is not true))
    {
        <meta name="robots" content="noindex"/>
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" asp-append-version="true"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" asp-append-version="true"/>
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" asp-append-version="true"/>
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" asp-append-version="true"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&display=swap"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<main>
    @RenderBody()
</main>

@* Search box takes focus on desktop only; on a phone it would raise the keyboard. *@
<script>
(function () {
    const desktop = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 721px)');
    function focusSearch() {
        const box = document.querySelector('input[data-autofocus]');
        if (!box || !desktop.matches) return;
        box.focus({ preventScroll: true });
        if (!box.value) return;
        const end = box.value.length;
        try { box.setSelectionRange(end, end); } catch (e) { }
    }
    focusSearch();
    window.addEventListener('pageshow', focusSearch);
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
