@model IReadOnlyList<(string Name, string Display)>

@* The sign-in providers, one small POST form each - a POST, so a link
   elsewhere cannot start a sign-in. Shown only for providers whose
   credentials are configured. *@
@if (Model.Count > 0)
{
    <div class="providers">
        @foreach (var (name, display) in Model)
        {
            <form method="post" asp-page="/Account/External" asp-route-provider="@name"
                  asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <button type="submit" class="btn provider">Continue with @display</button>
            </form>
        }
    </div>
}
