@model Web.Pages.InstructorsModel

@if (Model.Total == 0)
{
    <p class="empty">No professors matched.</p>
}
else
{
    <p class="count">
        @Model.Total.ToString("N0") professor@(Model.Total == 1 ? "" : "s")
        @if (Model.LastPage > 1)
        {
            <text>&middot; page @Model.Page of @Model.LastPage</text>
        }
    </p>

        @foreach (var person in Model.Results)
        {
            <article class="prof-card">
                <header class="prof-head">
                    <a class="prof-name" asp-page="/Instructor" asp-route-unid="@person.Unid" asp-route-slug="@Web.Pages.Names.Slug(person.Name)">
                        @Web.Pages.Names.Natural(person.Name)
                    </a>
                    <span class="prof-gpa">
                        @(person.AvgGpa?.ToString("0.00") ?? "N/A")
                        <span class="unit">avg GPA</span>
                    </span>
                </header>
                @if (!string.IsNullOrWhiteSpace(person.Department))
                {
                    <p class="prof-dept">@person.Department</p>
                }

                <p class="prof-sub">Class grades</p>

                @if (person.Courses.Count == 0)
                {
                    <p class="muted small">No grades published.</p>
                }
                else
                {
                    <div class="class-grid">
                        @foreach (var course in person.Courses)
                        {
                            @* Their page with this class already chosen. *@
                            <a class="class-card" asp-page="/Instructor"
                               asp-route-unid="@person.Unid" asp-route-slug="@Web.Pages.Names.Slug(person.Name)"
                               asp-route-course="@Web.Pages.Names.CourseSlug(course.Subject, course.CourseNumber)">
                                <span class="class-code">@course.Subject @course.CourseNumber</span>
                                <span class="class-title">@course.Title</span>
                                @* Their own average in this class, not the course's. *@
                                <span class="class-gpa">
                                    @if (course.AvgGpa is { } gpa)
                                    {
                                        <text>Average GPA: </text><strong>@gpa.ToString("0.00")</strong>
                                    }
                                    else
                                    {
                                        <span class="muted">No grades published</span>
                                    }
                                </span>
                            </a>
                        }
                    </div>
                }
            </article>
        }

    @if (Model.LastPage > 1)
    {
        @* The same chevrons as the builder's lists, either side of the page. *@
        <nav class="pager" aria-label="Pages">
            <button type="submit" name="pg" value="@(Model.Page - 1)" class="step"
                    disabled="@(!Model.HasPrevious)" aria-label="Previous page">
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <span class="pager-at">@Model.Page / @Model.LastPage</span>
            <button type="submit" name="pg" value="@(Model.Page + 1)" class="step"
                    disabled="@(!Model.HasNext)" aria-label="Next page">
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </nav>
    }
}
